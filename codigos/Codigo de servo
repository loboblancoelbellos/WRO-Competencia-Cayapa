#include <ESP32Servo.h>

Servo direccionServo;  
const int servoPin = 26; // Tu pin seguro confirmado

void setup() {
  Serial.begin(115200);

  // Configuración de temporizadores para ESP32
  ESP32PWM::allocateTimer(0);
  ESP32PWM::allocateTimer(1);
  ESP32PWM::allocateTimer(2);
  ESP32PWM::allocateTimer(3);
  direccionServo.setPeriodHertz(50); 
  
  // Conexión del servo
  direccionServo.attach(servoPin, 500, 2400); 

  Serial.println("==========================================");
  Serial.println("MODO DE CALIBRACIÓN MECÁNICA ACTIVADO");
  Serial.println("Servo bloqueado rígidamente a 90 grados.");
  Serial.println("Ya puedes ajustar físicamente el chasis.");
  Serial.println("==========================================");
  
  // Posicionar en el centro absoluto
  direccionServo.write(90);
}

void loop() {
  // Refrescar constantemente la posición para que el servo mantenga el torque
  direccionServo.write(90);
  delay(500); 
}
